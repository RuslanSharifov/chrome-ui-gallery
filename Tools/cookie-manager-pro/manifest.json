{
  "manifest_version": 3,
  "name": "Cookie Manager Pro",
  "version": "2.1.0",
  "description": "View, edit, add and delete cookies, save profiles, auto-clear and refresh. 10 languages.",
  "permissions": [
    "cookies",
    "tabs",
    "activeTab",
    "storage",
    "contextMenus",
    "browsingData",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://ruslansharifov.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Manager Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "clear-site": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Clear cookies for the current site"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
