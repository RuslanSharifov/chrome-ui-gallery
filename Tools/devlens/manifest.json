{
  "manifest_version": 3,
  "name": "DevLens",
  "version": "1.1.0",
  "description": "Developer HUD for console errors, logs and fetch/XHR requests on supported web pages.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DevLens"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/interceptor.js",
        "content/hud.js",
        "content/stats.js"
      ],
      "css": [
        "content/hud.css",
        "content/stats.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "minimum_chrome_version": "111",
  "host_permissions": [
    "https://ruslansharifov.github.io/*"
  ]
}
