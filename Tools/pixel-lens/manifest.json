{
  "manifest_version": 3,
  "name": "Pixel Lens",
  "version": "1.0.0",
  "description": "Interactive visual CSS inspector. Hover, pin and locally edit element styles.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Pixel Lens",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://ruslansharifov.github.io/*"
  ]
}
