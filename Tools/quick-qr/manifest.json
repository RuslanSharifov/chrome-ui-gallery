{
  "manifest_version": 3,
  "name": "Quick QR",
  "version": "1.0.0",
  "description": "Turn links or text into QR codes, copy links and save a PNG, entirely offline.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Quick QR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://ruslansharifov.github.io/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
