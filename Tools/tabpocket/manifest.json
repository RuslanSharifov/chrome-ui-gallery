{
  "manifest_version": 3,
  "name": "TabPocket",
  "version": "1.0.0",
  "description": "Save your tabs. Organize your browser.",
  "author": "Ruslan Sharifov",
  "permissions": ["tabs", "storage", "favicon"],
  "action": {
    "default_title": "TabPocket",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
