{
  "manifest_version": 3,
  "name": "Universal Dark",
  "version": "1.0.0",
  "description": "A simple customizable dark mode for websites: enable per site, adjust brightness and contrast.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://ruslansharifov.github.io/*"
  ],
  "action": {
    "default_title": "Universal Dark",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
