{
  "manifest_version": 3,
  "name": "ChatGPT Glassmorphism",
  "version": "2.1.0",
  "description": "Applies an adaptive glassmorphism theme to the existing ChatGPT UI (sidebar, composer, menus, profile and settings dialogs).",
  "permissions": ["storage", "activeTab"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "ChatGPT Glassmorphism",
    "default_popup": "index.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "css": ["glass.css"],
    "js": ["shared.js", "fx.js", "content.js"],
    "run_at": "document_start"
  }]
}
