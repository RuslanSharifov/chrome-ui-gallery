{
  "manifest_version": 3,
  "name": "Gemini Glassmorphism",
  "version": "1.2.0",
  "description": "Applies an adaptive glassmorphism visual layer to the existing Gemini web UI.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Gemini Glassmorphism",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "css": ["glass.css"],
      "js": ["shared.js", "fx.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
