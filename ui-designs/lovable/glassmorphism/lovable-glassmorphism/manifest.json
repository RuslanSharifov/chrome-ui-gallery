{
  "manifest_version": 3,
  "name": "Lovable Glassmorphism",
  "version": "1.0.0",
  "description": "Applies an adaptive glassmorphism theme with a live light background to the existing Lovable UI (dashboard, chat panel, composer, menus, dialogs).",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Lovable Glassmorphism",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "css": [
        "glass.css"
      ],
      "js": [
        "shared.js",
        "fx.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
