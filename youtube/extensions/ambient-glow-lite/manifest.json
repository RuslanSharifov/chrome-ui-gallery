{
  "manifest_version": 3,
  "name": "YouTube Ambient Glow Lite",
  "version": "1.0.0",
  "description": "Lightweight, dynamic ambient lighting around YouTube videos.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ambient Glow Lite",
    "default_popup": "popup.html"
  }
}
